# ============================================================
# RATE LIMITING CONFIGURATION (ALL THRESHOLDS CONFIGURABLE)
# ============================================================

# 1. Authentication Routes (Stricter Limits + Per-IP & Per-Account + Exponential Backoff)
RATE_LIMIT_AUTH_WINDOW_MS=900000       # 15 minutes window
RATE_LIMIT_AUTH_MAX_IP=10              # Max 10 attempts per IP
RATE_LIMIT_AUTH_MAX_ACCOUNT=5          # Max 5 attempts per account
RATE_LIMIT_AUTH_BASE_BACKOFF_MS=1000   # 1 second initial exponential delay
RATE_LIMIT_AUTH_MAX_BACKOFF_MS=60000   # 60 seconds maximum backoff delay
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0     # Multiplier (1s -> 2s -> 4s -> 8s -> 16s -> 32s -> 60s)

# 2. Public Endpoints (Moderate Limits)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000     # 15 minutes window
RATE_LIMIT_PUBLIC_MAX=100              # Max 100 requests per IP

# 3. Authenticated User Actions (Looser Limits)
RATE_LIMIT_AUTHED_WINDOW_MS=900000     # 15 minutes window
RATE_LIMIT_AUTHED_MAX=1000             # Max 1000 requests per User ID
